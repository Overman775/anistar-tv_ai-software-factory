{
  "editor.formatOnSave": true,
  "editor.rulers": [
    120
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "dart.lineLength": 120,
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  "dart.openDevTools": "flutter",
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "dart.showTodos": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.fvm": true,
    "**/.dart_tool": true,
    "**/*.freezed.dart": false,
    "**/*.g.dart": false
  },
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "files.insertFinalNewline": true,
    "editor.rulers": [
      120
    ],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "currentDocument"
  },
  "search.exclude": {
    "**/.fvm": true,
    "**/.dart_tool": true
  },
  "files.watcherExclude": {
    "**/.fvm": true,
    "**/.dart_tool": true,
    "**/build": true,
    "**/graphify-out": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "pubspec.yaml": ".flutter-plugins, .packages, .flutter-plugins-dependencies, .metadata, pubspec.lock, pubspec_overrides.yaml, .fvmrc, flutter_launcher_icons*.yaml, flutter_native_splash*.yaml",
    "analysis_options.yaml": "dcm_global.yaml",
    "*.dart": "${capture}.g.dart, ${capture}.freezed.dart",
    "readme*": "changelog*, codeowners, LICENSE"
  },
  "dart.flutterSdkPath": ".fvm/versions/3.44.2",
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "markdown.validate.enabled": true,
  "markdown.validate.fileLinks.enabled": "error",
  "markdown.validate.fragmentLinks.enabled": "error",
  "markdown.validate.referenceLinks.enabled": "error",
  "markdown.validate.duplicateLinkDefinitions.enabled": "error",
  "markdown.validate.unusedLinkDefinitions.enabled": "error",
  "markdown.updateLinksOnFileMove.enabled": "prompt",
  "cSpell.words": [
    "anistar",
    "astar",
    "inappwebview",
    "itemprop",
    "pagenav",
    "playlst",
    "usecase",
    "videoas"
  ]
}
