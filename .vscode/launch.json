{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Anistar TV (Development)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_dev.dart",
            "args": [
                "--flavor",
                "dev",
                "--dart-define-from-file",
                "${workspaceFolder}/env/dev.json"
            ]
        },
        {
            "name": "Anistar TV (Production)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_prod.dart",
            "args": [
                "--flavor",
                "prod",
                "--release",
                "--dart-define-from-file",
                "${workspaceFolder}/env/prod.example.json"
            ]
        },
        {
            "name": "Anistar TV (Profile Mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_dev.dart",
            "flutterMode": "profile",
            "args": [
                "--flavor",
                "dev",
                "--dart-define-from-file",
                "${workspaceFolder}/env/dev.json"
            ]
        }
    ]
}
