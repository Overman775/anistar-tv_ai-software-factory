{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Anistar TV (Development)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_dev.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "preLaunchTask": "env:prepare",
            "env": {
                "ANISTAR_ANDROID_SIGNING_MODE": "unsigned"
            },
            "toolArgs": [
                "--flavor",
                "dev",
                "--dart-define-from-file=${workspaceFolder}/env/dev.json"
            ]
        },
        {
            "name": "Anistar TV (Production)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_prod.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "preLaunchTask": "env:prepare",
            "env": {
                "ANISTAR_ANDROID_SIGNING_MODE": "unsigned"
            },
            "toolArgs": [
                "--flavor",
                "prod",
                "--dart-define-from-file=${workspaceFolder}/env/prod.json"
            ]
        },
        {
            "name": "Anistar TV (Profile Mode, Android only)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_dev.dart",
            "flutterMode": "profile",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "env:prepare",
            "env": {
                "ANISTAR_ANDROID_SIGNING_MODE": "unsigned"
            },
            "toolArgs": [
                "--flavor",
                "dev",
                "--dart-define-from-file=${workspaceFolder}/env/dev.json"
            ]
        }
    ]
}
