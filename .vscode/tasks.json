{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter: Generate Assets and Routes",
            "type": "shell",
            "command": "fvm dart run melos run generate",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Check",
            "type": "shell",
            "command": "fvm dart run melos run check",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Clean",
            "type": "shell",
            "command": "fvm dart run melos run clean",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Pub Get",
            "type": "shell",
            "command": "fvm dart run melos run get",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Build APK",
            "type": "shell",
            "command": "fvm dart run melos run build:android:prod:apk",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Build App Bundle",
            "type": "shell",
            "command": "fvm dart run melos run build:android:prod:bundle",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Run Tests",
            "type": "shell",
            "command": "fvm dart run melos run test:unit",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Format Code",
            "type": "shell",
            "command": "fvm dart run melos run format",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Analyze Code",
            "type": "shell",
            "command": "fvm dart run melos run analyze",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Check Goldens",
            "type": "shell",
            "command": "fvm dart run melos run test:goldens",
            "problemMatcher": []
        },
        {
            "label": "Flutter: TV E2E",
            "type": "shell",
            "command": "fvm dart run melos run test:e2e:tv --include-private",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Mobile E2E",
            "type": "shell",
            "command": "fvm dart run melos run test:e2e:mobile --include-private",
            "problemMatcher": []
        },
        {
            "label": "Flutter: TV and Mobile E2E",
            "type": "shell",
            "command": "fvm dart run melos run test:e2e",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Live Android E2E",
            "type": "process",
            "command": "fvm",
            "args": [
                "dart",
                "run",
                "melos",
                "run",
                "test:e2e:live",
                "--include-private"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "env:prepare",
            "type": "process",
            "command": "fvm",
            "args": [
                "dart",
                "run",
                "melos",
                "run",
                "env:prepare"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Flutter: Optional iOS E2E",
            "type": "process",
            "command": "fvm",
            "args": [
                "dart",
                "run",
                "melos",
                "run",
                "test:e2e:ios",
                "--",
                "${input:iosSimulator}",
                "${input:iosFlavor}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "iosSimulator",
            "type": "promptString",
            "description": "Booted iOS Simulator UDID (optional E2E)"
        },
        {
            "id": "iosFlavor",
            "type": "pickString",
            "description": "iOS fixture app flavor",
            "options": [
                "dev",
                "prod"
            ],
            "default": "dev"
        }
    ]
}
