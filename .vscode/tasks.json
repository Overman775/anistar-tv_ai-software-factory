{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter: Generate Assets and Routes",
            "type": "shell",
            "command": "fvm dart run build_runner build --workspace",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Check",
            "type": "shell",
            "command": "bash scripts/check.sh",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Clean",
            "type": "shell",
            "command": "fvm flutter clean",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Pub Get",
            "type": "shell",
            "command": "fvm flutter pub get",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Build APK",
            "type": "shell",
            "command": "fvm flutter build apk --release --flavor prod -t lib/main_prod.dart",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Build App Bundle",
            "type": "shell",
            "command": "fvm flutter build appbundle --release --flavor prod -t lib/main_prod.dart",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Run Tests",
            "type": "shell",
            "command": "bash scripts/check.sh test:unit",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Format Code",
            "type": "shell",
            "command": "bash scripts/check.sh format",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Analyze Code",
            "type": "shell",
            "command": "bash scripts/check.sh analyze",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Check Goldens",
            "type": "shell",
            "command": "bash scripts/check.sh test:goldens",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Android E2E",
            "type": "shell",
            "command": "bash scripts/e2e.sh ${input:androidEmulator}",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Live Android E2E",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/e2e.sh",
                "${input:androidEmulator}",
                "live"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "androidEmulator",
            "type": "promptString",
            "description": "Running Android emulator ID",
            "default": "emulator-5554"
        }
    ]
}
