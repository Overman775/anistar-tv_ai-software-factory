{
  "openapi": "3.1.0",
  "info": {
    "title": "AniStar Parser API",
    "description": "REST API for AniStar metadata and HLS proxying",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API origin; configure the generated Flutter client base URL"
    }
  ],
  "paths": {
    "/api/anime": {
      "get": {
        "tags": [
          "anime"
        ],
        "summary": "Get anime list",
        "description": "Retrieve a paginated list of anime from AniStar website.",
        "operationId": "listAnime",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 750,
              "minimum": 1,
              "description": "Page number (/page/{n})",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (/page/{n})"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with anime list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAnimeList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid page number"
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AniStar request or parsing failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/anime/{anime_id}/episodes": {
      "get": {
        "tags": [
          "anime"
        ],
        "summary": "Get anime episodes",
        "description": "Retrieve episode metadata and playback paths from the player page.",
        "operationId": "listAnimeEpisodes",
        "parameters": [
          {
            "name": "anime_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Anime Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Episode list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EpisodeInfo"
                  },
                  "title": "Response Listanimeepisodes"
                }
              }
            }
          },
          "404": {
            "description": "Anime or episode was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AniStar request or parsing failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/anime/{slug}": {
      "get": {
        "tags": [
          "anime"
        ],
        "summary": "Get anime details by slug",
        "description": "Retrieve anime information by slug from list endpoint.",
        "operationId": "getAnimeDetail",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+(?:-[a-z0-9]+)*$",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Anime details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnimeDetail"
                }
              }
            }
          },
          "404": {
            "description": "Anime or episode was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AniStar request or parsing failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/video/{anime_id}/episodes/{episode_number}/playback": {
      "get": {
        "tags": [
          "video"
        ],
        "summary": "Get HLS playback information",
        "description": "Returns a JSON contract for Flutter. Resolve `manifest_path` against the API base URL and pass the resulting URL to an HLS-capable player.",
        "operationId": "getPlaybackInfo",
        "parameters": [
          {
            "name": "anime_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Anime Id"
            }
          },
          {
            "name": "episode_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Episode Number"
            }
          },
          {
            "name": "quality",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/QualityType",
              "description": "Preferred quality",
              "default": "720"
            },
            "description": "Preferred quality"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired resource token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Anime episode was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AniStar or its CDN failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/video/{anime_id}/episodes/{episode_number}/manifest.m3u8": {
      "get": {
        "tags": [
          "video"
        ],
        "summary": "Get a rewritten HLS manifest",
        "description": "Returns an HLS manifest whose resources use short-lived signed API paths.",
        "operationId": "getHlsManifest",
        "parameters": [
          {
            "name": "anime_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Anime Id"
            }
          },
          {
            "name": "episode_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Episode Number"
            }
          },
          {
            "name": "quality",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/QualityType",
              "description": "Preferred quality",
              "default": "720"
            },
            "description": "Preferred quality"
          }
        ],
        "responses": {
          "200": {
            "description": "HLS manifest text",
            "content": {
              "application/vnd.apple.mpegurl": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "X-Requested-Quality": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Selected-Quality": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired resource token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Anime episode was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AniStar or its CDN failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/video/{anime_id}/episodes/{episode_number}/resources/{token}": {
      "get": {
        "tags": [
          "video"
        ],
        "summary": "Stream a signed HLS resource",
        "description": "Used by URLs embedded in the rewritten manifest. Flutter applications normally do not call this operation directly.",
        "operationId": "getHlsResource",
        "parameters": [
          {
            "name": "anime_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Anime Id"
            }
          },
          {
            "name": "episode_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Episode Number"
            }
          },
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 4096,
              "title": "Token"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^bytes=\\d*-\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Single HTTP byte range",
              "title": "Range"
            },
            "description": "Single HTTP byte range"
          }
        ],
        "responses": {
          "200": {
            "description": "Manifest, media segment, key, or initialization bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Partial media response",
            "headers": {
              "Content-Range": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired resource token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Anime episode was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AniStar or its CDN failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check process liveness",
        "description": "Does not contact AniStar. Use this endpoint for container health checks.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check AniStar readiness",
        "description": "Returns HTTP 503 when the upstream dependency is unavailable.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "AniStar is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnimeDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Id",
            "description": "Anime ID on website"
          },
          "slug": {
            "type": "string",
            "title": "Slug",
            "description": "URL slug for detail page (e.g., '10247-title-here')"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title",
            "description": "Full title"
          },
          "year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year",
            "description": "Release year"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres",
            "description": "List of genres"
          },
          "voiceover": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voiceover",
            "description": "Voiceover type"
          },
          "series_info": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Series Info",
            "description": "Series info as shown on site (e.g. '(52 эп.), 25 мин.')"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Anime description"
          },
          "is_ongoing": {
            "type": "boolean",
            "title": "Is Ongoing",
            "description": "Whether anime is currently airing (ongoing)",
            "default": false
          },
          "poster_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Url",
            "description": "Poster image URL (None if not available)"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "title"
        ],
        "title": "AnimeDetail",
        "description": "Complete anime information from mobile site."
      },
      "AnimeListItem": {
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Id",
            "description": "Anime ID on website"
          },
          "slug": {
            "type": "string",
            "title": "Slug",
            "description": "URL slug for detail page (e.g., '10247-title-here')"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title",
            "description": "Full title"
          },
          "year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year",
            "description": "Release date"
          },
          "poster_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Poster Url",
            "description": "Poster image URL"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "poster_url"
        ],
        "title": "AnimeListItem",
        "description": "Anime list item with minimal information from mobile site."
      },
      "EpisodeInfo": {
        "properties": {
          "episode_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Episode Number",
            "description": "Episode number"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Episode title"
          },
          "preview_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview Url",
            "description": "Preview image URL"
          },
          "playback_path": {
            "type": "string",
            "title": "Playback Path",
            "description": "API-relative JSON playback endpoint for this episode"
          }
        },
        "type": "object",
        "required": [
          "episode_number",
          "title",
          "playback_path"
        ],
        "title": "EpisodeInfo",
        "description": "Episode information."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Error type"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Error detail message"
          },
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Request path"
          }
        },
        "type": "object",
        "required": [
          "error",
          "detail",
          "path"
        ],
        "title": "ErrorResponse",
        "description": "Error response."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "service",
          "timestamp"
        ],
        "title": "LivenessResponse",
        "description": "Process health independent of AniStar availability."
      },
      "PaginatedAnimeList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnimeListItem"
            },
            "type": "array",
            "title": "Items"
          },
          "current_page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Current Page",
            "description": "Current page number"
          },
          "has_next": {
            "type": "boolean",
            "title": "Has Next",
            "description": "Whether next page exists"
          },
          "has_prev": {
            "type": "boolean",
            "title": "Has Prev",
            "description": "Whether previous page exists"
          }
        },
        "type": "object",
        "required": [
          "current_page",
          "has_next",
          "has_prev"
        ],
        "title": "PaginatedAnimeList",
        "description": "Paginated response for anime list."
      },
      "PlaybackInfo": {
        "properties": {
          "anime_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Anime Id"
          },
          "episode_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Episode Number"
          },
          "requested_quality": {
            "$ref": "#/components/schemas/QualityType"
          },
          "selected_quality": {
            "$ref": "#/components/schemas/QualityType"
          },
          "available_qualities": {
            "items": {
              "$ref": "#/components/schemas/QualityType"
            },
            "type": "array",
            "title": "Available Qualities"
          },
          "manifest_path": {
            "type": "string",
            "title": "Manifest Path",
            "description": "API-relative HLS manifest path; resolve it against the configured API base URL"
          },
          "segment_token_ttl_seconds": {
            "type": "integer",
            "minimum": 30.0,
            "title": "Segment Token Ttl Seconds"
          }
        },
        "type": "object",
        "required": [
          "anime_id",
          "episode_number",
          "requested_quality",
          "selected_quality",
          "available_qualities",
          "manifest_path",
          "segment_token_ttl_seconds"
        ],
        "title": "PlaybackInfo",
        "description": "Flutter-friendly description of an HLS playback session."
      },
      "QualityType": {
        "type": "string",
        "enum": [
          "360",
          "720"
        ],
        "title": "QualityType",
        "description": "Available video qualities on AniStar.\n\nAniStar provides only two quality options:\n- 360p: Lower quality, smaller file size\n- 720p: HD quality (default and recommended)"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "service": {
