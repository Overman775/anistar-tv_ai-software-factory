# Miscellaneous
**/key.properties
*.jks
*.keystore
*.p12
*.pfx
.session-password
**/.session-password
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# FVM Version Cache
.fvm/

# Generated Graphify state is local; agent instructions and configs are shared.
graphify-out/

# Machine-specific production endpoint for --dart-define-from-file.
/env/prod.json

# Deterministic test artifacts; golden baselines remain tracked.
coverage/
/test/**/failures/

# Python tooling bytecode.
**/__pycache__/

# Local dotenv inputs; public templates remain available to Git.
.env
.env.*
*.env
!**/.env.example
!**/.env.sample
!**/.env.template

# Local live-test credentials, never committed.
/env/*.local.json

# Private signing inputs and live-test credentials, never committed.
/.private/

# Factory runtime artifacts; shared roles, skills and configuration remain tracked.
/.ai-pipeline/state/
/.ai-pipeline/staging/

# Personal agent overrides and locks; shared instructions/configs remain tracked.
AGENTS.local.md
CLAUDE.local.md
**/.claude/settings.local.json
**/.claude/*.lock
**/.codex/settings.local.json
**/.codex/*.lock

# External skill bundles are installed locally; Factory skills remain shared.
/.agents/skills/graphify
/.agents/skills/impeccable
/.agents/skills/asd-ste100
/.codex/skills/graphify
/.codex/skills/impeccable
/.codex/skills/asd-ste100
/.claude/skills/graphify
/.claude/skills/impeccable
/.claude/skills/asd-ste100
